default_platform(:ios)

platform :ios do

  desc "Generate Xcode project with Tuist"
  lane :generate do
    sh("cd .. && tuist install && tuist generate --no-open")
  end

  desc "Build and upload a beta to TestFlight"
  lane :beta do
    generate

    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      duration: 1200,
      in_house: false
    )

    match(
      type: "appstore",
      readonly: ENV["CI"] == "true",
      api_key: api_key
    )

    increment_build_number(
      xcodeproj: "MIND.xcodeproj",
      build_number: ENV["BUILD_NUMBER"] || latest_testflight_build_number(
        api_key: api_key,
        app_identifier: "com.mind.app"
      ).to_i.next.to_s
    )

    build_app(
      scheme: "MIND",
      project: "MIND.xcodeproj",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "MIND.ipa",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      ipa: "build/MIND.ipa"
    )
  end
end
