    "onboarding.anthropic.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MIND uses the Anthropic API for chat, audit synthesis, and pitch generation. Without a key these features stay inert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MIND s'appuie sur l'API Anthropic pour le chat, la synthèse d'audit et la génération de pitchs. Sans clé, ces fonctions restent inertes."
          }
