    "audit.broadcast.deploy.hint": {
      "comment": "v0.22 · Footer hint in the broadcast share sheet — explains how to expose the local folder.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve the broadcast folder with `npx serve` and expose it via `cloudflared tunnel`, ngrok, or tailscale serve — or drag-drop it onto Vercel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoste le dossier de diffusion avec `npx serve` et expose-le via `cloudflared tunnel`, ngrok ou tailscale serve — ou drag-drop sur Vercel."
          }
        }
      }
    },
