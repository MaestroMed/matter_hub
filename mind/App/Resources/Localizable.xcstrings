    "audit.export.portal.success.body": {
      "comment": "v0.21 · Body copy of the portal-generated success sheet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your client portal is ready. Open it in Files to drag-drop it onto Vercel or Cloudflare Pages, or share the folder directly."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton portail client est prêt. Ouvre-le dans Fichiers pour le déposer sur Vercel ou Cloudflare Pages, ou partage directement le dossier."
          }
        }
      }
    },
    "audit.export.portal.success.openInFiles": {
