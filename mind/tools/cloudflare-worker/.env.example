# Copy to .dev.vars for `wrangler dev`, or set via `wrangler secret put`
# for production. Never commit real values.

# HMAC-SHA256 shared secret. Generate with:
#   openssl rand -hex 32
# Paste the same value into MIND iOS → Settings → "Lead webhook".
WEBHOOK_SECRET=

# v1.1.0 — HMAC-SHA1 shared secret used by Vercel deployment
# webhooks (Vercel signs the body with SHA-1 under x-vercel-signature).
# Paste this value into each Vercel project: Settings → Webhooks →
# Add Webhook, then mirror it under
# MIND iOS → Réglages → "Webhook Vercel".
VERCEL_WEBHOOK_SECRET=

# APNs auth key downloaded from Apple Developer → Keys.
# Paste the entire .p8 contents including the
# -----BEGIN PRIVATE KEY----- / -----END PRIVATE KEY----- envelope.
APNS_KEY_P8=

# 10-char Apple key identifier shown next to the .p8 download.
APNS_KEY_ID=

# 10-char Apple Team ID, e.g. ABCDE12345.
APNS_TEAM_ID=

# Per-device push token reported by the iOS app after the user taps
# Settings → "Connect device". Hex, 64 chars (32 bytes).
APNS_DEVICE_TOKEN=
